# Better Auth Secret (genera uno con: openssl rand -base64 32)
BETTER_AUTH_SECRET="tu_secreto_generado_aqui"

# Better Auth URL (en local http://localhost:3000, en producción la URL de tu app)
BETTER_AUTH_URL="http://localhost:3000"

# Base de datos PostgreSQL / Neon
DATABASE_URL="postgresql://usuario:password@host/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:password@host/neondb?sslmode=require"
